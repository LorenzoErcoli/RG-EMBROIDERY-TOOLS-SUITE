{
  "name": "rg-embroidery-tools-suite",
  "version": "0.1.0",
  "private": true,
  "description": "RG Embroidery Tools Suite — strumenti per ricamo: core condiviso + design system + app. Vedi COSTITUZIONE-RICAMO.md e ARCHITETTURA.md.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/pattern-grammar",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/shell",
    "suite": "npm run start --workspace apps/shell",
    "dev:shell": "npm run dev --workspace apps/shell",
    "dev:net-45": "npm run dev --workspace apps/net-45",
    "dev:interlace": "npm run dev --workspace apps/interlace",
    "dev:bitmap": "npm run dev --workspace apps/bitmap",
    "dev:oblique": "npm run dev --workspace apps/oblique",
    "dev:striatura": "npm run dev --workspace apps/striatura",
    "build": "npm run build --workspace apps/shell",
    "build:net-45": "npm run build --workspace apps/net-45",
    "test": "node test/smoke.mjs"
  }
}
